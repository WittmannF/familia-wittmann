---
import BaseLayout from '../layouts/BaseLayout.astro';
import CardLink from '../components/CardLink.astro';
import { url } from '../lib/paths';
---
<BaseLayout title="Família Wittmann">
  <section class="container hero content">
    <div class="eyebrow">Memórias, histórias e tradições</div>
    <h1>Família Wittmann</h1>
    <p class="lead">Um espaço simples para preservar memoriais, histórias da família e tradições.</p>
    <p style="display:flex;gap:10px;flex-wrap:wrap;margin-top:24px"><a class="button" href={url('/memoriais')}>Ver memoriais</a><a class="button secondary" href={url('/enviar')}>Enviar memória</a></p>
  </section>
  <section class="container section featured">
    <div>
      <span class="tag">Memorial em destaque</span>
      <h2 class="serif">Ivo Amandio Wittmann</h2>
      <p>O primeiro memorial publicado reúne homenagem, história de vida, fotos, mensagens e lembranças.</p>
    </div>
    <p><a class="button" href={url('/ivo')}>Abrir memorial</a></p>
  </section>
  <section class="container section grid grid-3">
    <CardLink href={url('/memoriais')} title="Memoriais" text="Histórias de vida, fotos, mensagens e lembranças de familiares queridos." />
    <CardLink href={url('/familia')} title="Família" text="Origem, genealogia, imigração e registros históricos da Família Wittmann." />
    <CardLink href={url('/caderno')} title="Caderno da família" text="Tradições, jogos, receitas e materiais úteis preservados pela família." />
    <CardLink href={url('/enviar')} title="Enviar memória" text="Compartilhe relatos, fotos, áudios, vídeos ou documentos para revisão familiar." />
  </section>
</BaseLayout>
